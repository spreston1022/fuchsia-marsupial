{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "MCP Gateway"
  },
  "paths": {
    "/mcp": {
      "post,get,delete": {
        "operationId": "mcp-aggregate",
        "summary": "Aggregated MCP endpoint",
        "description": "Single MCP endpoint that combines the tools of every upstream MCP route below.",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "default",
            "module": "$import(./modules/mcp-aggregator)",
            "options": {
              "serverName": "single-mcp",
              "upstreams": [
                {
                  "name": "stripe",
                  "route": "/mcp/stripe"
                },
                {
                  "name": "linear",
                  "route": "/mcp/linear"
                }
              ]
            }
          },
          "policies": {
            "inbound": [
              "mcp-oauth"
            ]
          }
        }
      }
    },
    "/mcp/stripe": {
      "get,post,delete": {
        "operationId": "mcp-stripe",
        "summary": "Stripe MCP proxy",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "McpProxyHandler",
            "module": "$import(@zuplo/runtime/mcp-gateway)",
            "options": {
              "rewritePattern": "https://mcp.stripe.com"
            }
          },
          "policies": {
            "inbound": [
              "internal-only",
              "inherit-gateway-user",
              "mcp-token-exchange-stripe"
            ]
          }
        }
      }
    },
    "/mcp/linear": {
      "get,post,delete": {
        "operationId": "mcp-linear",
        "summary": "Linear MCP proxy",
        "x-zuplo-route": {
          "corsPolicy": "none",
          "handler": {
            "export": "McpProxyHandler",
            "module": "$import(@zuplo/runtime/mcp-gateway)",
            "options": {
              "rewritePattern": "https://mcp.linear.app/mcp"
            }
          },
          "policies": {
            "inbound": [
              "internal-only",
              "inherit-gateway-user",
              "mcp-token-exchange-linear"
            ]
          }
        }
      }
    }
  }
}
